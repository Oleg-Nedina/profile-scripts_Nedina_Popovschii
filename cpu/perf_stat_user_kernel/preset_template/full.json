{
  "preset_name": "Full Profiling Summary",
  "metrics": [
    {
      "name": "IPC (Ins/Cycle)",
      "formula": "PAPI_TOT_INS / PAPI_TOT_CYC",
      "format": "{val:.3f}",
      "thresholds": [
        {"min": 0.0, "tag": "Pipeline-bound"}
      ]
    },
    {
      "name": "L1 MPKI (miss/KIns)",
      "formula": "(PAPI_L1_DCM / PAPI_TOT_INS) * 1000",
      "format": "{val:.3f}",
      "thresholds": [
        {"min": 50.0, "tag": "L1-bound"}
      ]
    },
    {
      "name": "L2 MPKI (miss/KIns)",
      "formula": "(PAPI_L2_DCM / PAPI_TOT_INS) * 1000",
      "format": "{val:.3f}",
      "thresholds": [
        {"min": 10.0, "tag": "Memory-bound"}
      ]
    },
    {
      "name": "Branch Miss Rate (%)",
      "formula": "(PAPI_BR_MSP / PAPI_BR_INS) * 100",
      "format": "{val:.2f}%",
      "thresholds": [
        {"min": 5.0, "tag": "Branch-bound"}
      ]
    }
  ]
}
