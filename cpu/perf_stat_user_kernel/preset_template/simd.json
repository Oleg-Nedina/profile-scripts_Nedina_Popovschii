{
  "preset_name": "SIMD / Floating-Point Analysis",
  "metrics": [
    {
      "name": "IPC (Ins/Cycle)",
      "formula": "PAPI_TOT_INS / PAPI_TOT_CYC",
      "format": "{val:.3f}",
      "thresholds": [
        {"min": 0.0, "tag": "Pipeline-bound"}
      ]
    },
    {
      "name": "Vectorization Rate (%)",
      "formula": "(PAPI_VEC_INS / PAPI_TOT_INS) * 100",
      "format": "{val:.2f}%",
      "thresholds": [
        {"min": 30.0, "tag": ""},
        {"min": 0.0, "tag": "Low SIMD utilization"}
      ]
    },
    {
      "name": "FP Ops / Instr (%)",
      "formula": "(PAPI_FP_OPS / PAPI_TOT_INS) * 100",
      "format": "{val:.2f}%",
      "thresholds": []
    },
    {
      "name": "FP Instr / Total Instr (%)",
      "formula": "(PAPI_FP_INS / PAPI_TOT_INS) * 100",
      "format": "{val:.2f}%",
      "thresholds": []
    }
  ]
}

