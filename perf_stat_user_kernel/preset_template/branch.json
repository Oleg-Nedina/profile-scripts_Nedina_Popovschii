{
  "preset_name": "Branch Predictor Analysis",
  "metrics": [
    {
      "name": "IPC (Ins/Ciclo)",
      "formula": "PAPI_TOT_INS / PAPI_TOT_CYC",
      "format": "{val:.3f}",
      "thresholds": [
        {"min": 3.5, "tag": "✓ eccellente (Zen5 max ~4)"},
        {"min": 1.0, "tag": "✓ buono"},
        {"min": 0.0, "tag": "⚠ pipeline-bound (< 1.0)"}
      ]
    },
    {
      "name": "Branch Miss Rate (%)",
      "formula": "(PAPI_BR_MSP / PAPI_BR_INS) * 100",
      "format": "{val:.2f}%",
      "thresholds": [
        {"min": 5.0, "tag": "⚠ branch-bound (> 5%)"},
        {"min": 1.0, "tag": "→ accettabile"},
        {"min": 0.0, "tag": "✓ basso"}
      ]
    },
    {
      "name": "Branch / Instructions (%)",
      "formula": "(PAPI_BR_INS / PAPI_TOT_INS) * 100",
      "format": "{val:.2f}%",
      "thresholds": []
    }
  ]
}
