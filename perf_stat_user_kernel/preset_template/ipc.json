{
  "preset_name": "Solo IPC (Instructions Per Cycle)",
  "metrics": [
    {
      "name": "IPC (Ins/Ciclo)",
      "formula": "PAPI_TOT_INS / PAPI_TOT_CYC",
      "format": "{val:.3f}",
      "thresholds": [
        {"min": 3.5, "tag": "✓ eccellente (Zen5 max ~4)"},
        {"min": 1.0, "tag": "✓ buono"},
        {"min": 0.0, "tag": "⚠ pipeline-bound (< 1.0)"}
      ]
    }
  ]
}
